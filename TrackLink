<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>TrackLink</title>

  <!-- MAPA -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  >

  <style>

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {

      min-height: 100vh;

      background:
        radial-gradient(
          circle at top,
          #182331 0%,
          #0b0b0b 45%,
          #050505 100%
        );

      color: white;

      padding: 20px;

      display: flex;

      justify-content: center;

      align-items: center;

      overflow-x: hidden;

    }

    /* =========================
       ANIMACIONES
    ========================= */

    @keyframes appEntrada {

      0% {
        opacity: 0;
        transform:
          translateY(35px)
          scale(.94);
      }

      100% {
        opacity: 1;
        transform:
          translateY(0)
          scale(1);
      }

    }

    @keyframes logoEntrada {

      0% {
        opacity: 0;
        transform:
          translateY(-25px);
      }

      100% {
        opacity: 1;
        transform:
          translateY(0);
      }

    }

    @keyframes tarjetaEntrada {

      0% {
        opacity: 0;
        transform:
          translateY(25px);
      }

      100% {
        opacity: 1;
        transform:
          translateY(0);
      }

    }

    @keyframes botonEntrada {

      0% {
        opacity: 0;
        transform: scale(.92);
      }

      100% {
        opacity: 1;
        transform: scale(1);
      }

    }

    @keyframes pulse {

      0% {
        box-shadow:
          0 0 0 0 rgba(77,163,255,.35);
      }

      70% {
        box-shadow:
          0 0 0 12px rgba(77,163,255,0);
      }

      100% {
        box-shadow:
          0 0 0 0 rgba(77,163,255,0);
      }

    }

    .app {

      width: 100%;

      max-width: 460px;

      background: #111;

      border: 1px solid #292929;

      border-radius: 26px;

      padding: 24px;

      box-shadow:
        0 25px 80px rgba(0,0,0,.65);

      animation:
        appEntrada
        .75s
        cubic-bezier(.2,.8,.2,1);

    }

    .logo {

      text-align: center;

      margin-bottom: 25px;

      animation:
        logoEntrada
        .8s
        ease-out;

    }

    .logo h1 {

      font-size: 36px;

      letter-spacing: -1px;

    }

    .logo span {

      color: #4da3ff;

    }

    .logo p {

      color: #777;

      margin-top: 7px;

      font-size: 14px;

    }

    .card {

      background: #181818;

      border-radius: 19px;

      padding: 20px;

      border: 1px solid #252525;

      animation:
        tarjetaEntrada
        .9s
        ease-out
        .12s
        both;

    }

    .card h2 {

      margin-bottom: 10px;

      font-size: 20px;

    }

    .card p {

      color: #999;

      line-height: 1.55;

      font-size: 14px;

    }

    button {

      width: 100%;

      border: none;

      border-radius: 14px;

      padding: 16px;

      margin-top: 18px;

      background: #4da3ff;

      color: white;

      font-size: 16px;

      font-weight: bold;

      cursor: pointer;

      transition:
        transform .2s,
        opacity .2s,
        box-shadow .2s;

    }

    button:hover {

      transform: translateY(-2px);

    }

    button:active {

      transform: scale(.97);

    }

    #createButton {

      animation:
        botonEntrada
        .7s
        ease-out
        .35s
        both;

    }

    #createButton:hover {

      box-shadow:
        0 8px 30px rgba(77,163,255,.25);

    }

    button:disabled {

      opacity: .5;

      cursor: default;

      transform: none;

    }

    /* =========================
       RESULTADO
    ========================= */

    .result {

      display: none;

      margin-top: 20px;

      animation:
        tarjetaEntrada
        .6s
        ease-out;

    }

    .linkBox {

      background:
        linear-gradient(
          145deg,
          #151f29,
          #101820
        );

      border: 1px solid #285b82;

      border-radius: 16px;

      padding: 16px;

    }

    .linkTitle {

      color: #aaa;

      font-size: 13px;

      margin-bottom: 8px;

    }

    .link {

      color: #62b1ff;

      word-break: break-all;

      font-size: 13px;

      line-height: 1.5;

    }

    .status {

      margin-top: 15px;

      padding: 14px;

      border-radius: 12px;

      background: #202020;

      color: #aaa;

      font-size: 13px;

      line-height: 1.5;

    }

    /* =========================
       MAPA
    ========================= */

    .mapContainer {

      display: none;

      margin-top: 20px;

      overflow: hidden;

      border-radius: 18px;

      border: 1px solid #333;

      animation:
        tarjetaEntrada
        .7s
        ease-out;

    }

    #map {

      width: 100%;

      height: 330px;

    }

    .mapsButton {

      background: #202020;

      border: 1px solid #333;

      animation:
        botonEntrada
        .5s
        ease-out;

    }

    /* =========================
       DATOS
    ========================= */

    .data {

      display: none;

      margin-top: 20px;

      animation:
        tarjetaEntrada
        .6s
        ease-out;

    }

    .dataTitle {

      font-size: 18px;

      margin-bottom: 10px;

    }

    .dataItem {

      background: #1b1b1b;

      border: 1px solid #252525;

      padding: 14px;

      border-radius: 12px;

      margin-top: 8px;

      font-size: 13px;

      line-height: 1.5;

    }

    .dataItem span {

      color: #888;

    }

    .dataItem strong {

      color: white;

      word-break: break-word;

    }

    .device {

      display: none;

    }

    .camera {

      display: none;

    }

    .reset {

      background: transparent;

      border: 1px solid #333;

      color: #aaa;

    }

    .reset:hover {

      background: #181818;

    }

    /* =========================
       REDUCIR ANIMACIONES
    ========================= */

    @media (
      prefers-reduced-motion: reduce
    ) {

      .app,
      .logo,
      .card,
      #createButton,
      .result,
      .mapContainer,
      .mapsButton,
      .data {

        animation: none !important;

      }

    }

  </style>

</head>


<body>


<div class="app">


  <!-- LOGO -->

  <div class="logo">

    <h1>
      Track<span>Link</span>
    </h1>

    <p>
      Panel de ubicación
    </p>

  </div>


  <!-- CREAR ENLACE -->

  <div class="card">

    <h2>
      Nueva solicitud
    </h2>

    <p>

      Crea un enlace para que otra persona
      pueda decidir si desea compartir
      su información mediante permisos.

    </p>


    <button
      id="createButton"
      type="button"
    >

      🔗 Crear enlace

    </button>

  </div>


  <!-- RESULTADO -->

  <div
    class="result"
    id="result"
  >


    <!-- ENLACE -->

    <div class="linkBox">

      <div class="linkTitle">

        Enlace generado

      </div>


      <div
        class="link"
        id="link"
      ></div>


      <button
        id="copyButton"
        type="button"
      >

        📋 Copiar enlace

      </button>

    </div>


    <!-- ESTADO -->

    <div
      class="status"
      id="status"
      aria-live="polite"
    >

      🟡 Esperando que la persona
      abra el enlace...

    </div>


    <!-- MAPA -->

    <div
      class="mapContainer"
      id="mapContainer"
    >

      <div id="map"></div>

    </div>


    <!-- GOOGLE MAPS -->

    <button
      class="mapsButton"
      id="mapsButton"
      type="button"
      style="display:none;"
    >

      🌎 Abrir en Google Maps

    </button>


    <!-- INFORMACIÓN -->

    <div
      class="data"
      id="data"
    >

      <div class="dataTitle">

        Información recibida

      </div>


      <div class="dataItem">

        <span>
          📍 Latitud
        </span>

        <br>

        <strong id="latitude">
        </strong>

      </div>


      <div class="dataItem">

        <span>
          📍 Longitud
        </span>

        <br>

        <strong id="longitude">
        </strong>

      </div>


      <div class="dataItem">

        <span>
          🎯 Precisión
        </span>

        <br>

        <strong id="accuracy">
        </strong>

      </div>


      <div
        class="dataItem camera"
        id="cameraBox"
      >

        <span>
          📷 Cámara
        </span>

        <br>

        <strong id="camera">
        </strong>

      </div>


      <div
        class="dataItem device"
        id="deviceBox"
      >

        <span>
          📱 Dispositivo
        </span>

        <br>

        <strong id="device">
        </strong>

      </div>


      <div class="dataItem">

        <span>
          🕒 Recibido
        </span>

        <br>

        <strong id="received">
        </strong>

      </div>

    </div>


    <!-- NUEVO -->

    <button
      class="reset"
      id="newButton"
      type="button"
    >

      ＋ Crear otro enlace

    </button>


  </div>


</div>


<!-- LEAFLET -->

<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
></script>


<script>


/* =========================
   SERVIDOR
========================= */

const SERVER =
  "https://wynex-server.onrender.com";


/* =========================
   VARIABLES
========================= */

let requestId = null;

let timer = null;

let map = null;

let marker = null;

let mapsUrl = null;


/* =========================
   ELEMENTOS
========================= */

const createButton =
  document.getElementById(
    "createButton"
  );

const copyButton =
  document.getElementById(
    "copyButton"
  );

const newButton =
  document.getElementById(
    "newButton"
  );

const result =
  document.getElementById(
    "result"
  );

const linkElement =
  document.getElementById(
    "link"
  );

const statusElement =
  document.getElementById(
    "status"
  );

const mapContainer =
  document.getElementById(
    "mapContainer"
  );

const mapsButton =
  document.getElementById(
    "mapsButton"
  );

const dataElement =
  document.getElementById(
    "data"
  );


/* =========================
   CREAR ENLACE
========================= */

createButton.addEventListener(
  "click",
  async () => {

    createButton.disabled =
      true;


    statusElement.textContent =
      "Creando enlace...";


    try {

      const response =
        await fetch(
          SERVER +
          "/api/tracklink/create",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json"
            }
          }
        );


      const resultData =
        await response.json();


      if (!resultData.ok) {

        throw new Error(
          resultData.error ||
          "Error"
        );

      }


      requestId =
        resultData.id;


      linkElement.textContent =
        resultData.link;


      result.style.display =
        "block";


      statusElement.textContent =
        "🟡 Esperando que la persona abra el enlace y autorice los permisos...";


      startChecking();


    } catch (error) {

      console.error(error);


      statusElement.textContent =
        "❌ No se pudo conectar con TrackLink.";

    }


    createButton.disabled =
      false;

  }
);


/* =========================
   COPIAR
========================= */

copyButton.addEventListener(
  "click",
  async () => {

    try {

      await navigator.clipboard.writeText(
        linkElement.textContent
      );


      statusElement.textContent =
        "✅ Enlace copiado correctamente.";


    } catch (error) {

      statusElement.textContent =
        "Copia el enlace manualmente.";

    }

  }
);


/* =========================
   GOOGLE MAPS
========================= */

mapsButton.addEventListener(
  "click",
  () => {

    if (mapsUrl) {

      window.open(
        mapsUrl,
        "_blank"
      );

    }

  }
);


/* =========================
   COMPROBAR RESULTADO
========================= */

function startChecking() {

  if (timer) {

    clearInterval(timer);

  }


  timer =
    setInterval(
      checkResult,
      3000
    );

}


async function checkResult() {

  if (!requestId) {

    return;

  }


  try {

    const response =
      await fetch(
        SERVER +
        "/api/tracklink/result/" +
        encodeURIComponent(
          requestId
        )
      );


    const resultData =
      await response.json();


    if (!resultData.ok) {

      return;

    }


    if (
      resultData.status ===
        "received" &&
      resultData.data
    ) {

      clearInterval(
        timer
      );


      showLocation(
        resultData.data
      );

    }


  } catch (error) {

    console.error(
      "Error consultando:",
      error
    );

  }

}


/* =========================
   MOSTRAR DATOS
========================= */

function showLocation(data) {


  const latitude =
    Number(data.latitude);

  const longitude =
    Number(data.longitude);


  if (
    !Number.isFinite(latitude) ||
    !Number.isFinite(longitude)
  ) {

    return;

  }


  statusElement.textContent =
    "🟢 Información recibida con autorización.";


  dataElement.style.display =
    "block";


  document.getElementById(
    "latitude"
  ).textContent =
    latitude;


  document.getElementById(
    "longitude"
  ).textContent =
    longitude;


  document.getElementById(
    "accuracy"
  ).textContent =
    data.accuracy
      ? Math.round(
          data.accuracy
        ) + " metros"
      : "No disponible";


  document.getElementById(
    "received"
  ).textContent =
    data.receivedAt
      ? new Date(
          data.receivedAt
        ).toLocaleString()
      : "No disponible";


  /* =========================
     CÁMARA
  ========================= */

  if (
    data.cameraPermission
  ) {

    const cameraBox =
      document.getElementById(
        "cameraBox"
      );

    const cameraText =
      document.getElementById(
        "camera"
      );


    cameraBox.style.display =
      "block";


    if (
      data.cameraPermission ===
      "granted"
    ) {

      cameraText.textContent =
        "Permiso concedido";

    }

    else if (
      data.cameraPermission ===
      "denied"
    ) {

      cameraText.textContent =
        "Permiso rechazado";

    }

    else {

      cameraText.textContent =
        data.cameraPermission;

    }

  }


  /* =========================
     DISPOSITIVO
  ========================= */

  if (
    data.deviceInfo
  ) {

    const deviceBox =
      document.getElementById(
        "deviceBox"
      );

    const deviceText =
      document.getElementById(
        "device"
      );


    deviceBox.style.display =
      "block";


    const device =
      data.deviceInfo;


    let text = "";


    if (device.platform) {

      text +=
        "Plataforma: " +
        device.platform +
        "<br>";

    }


    if (device.language) {

      text +=
        "Idioma: " +
        device.language +
        "<br>";

    }


    if (
      device.screenWidth &&
      device.screenHeight
    ) {

      text +=
        "Pantalla: " +
        device.screenWidth +
        " × " +
        device.screenHeight +
        "<br>";

    }


    if (device.userAgent) {

      text +=
        "Navegador: " +
        device.userAgent;

    }


    deviceText.innerHTML =
      text ||
      "No disponible";

  }


  /* =========================
     MAPA
========================= */

  mapContainer.style.display =
    "block";


  if (!map) {

    map =
      L.map(
        "map",
        {
          zoomControl: true
        }
      ).setView(
        [
          latitude,
          longitude
        ],
        16
      );


    L.tileLayer(
      "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
      {

        maxZoom: 19,

        attribution:
          "&copy; OpenStreetMap"

      }
    ).addTo(
      map
    );


  } else {

    map.setView(
      [
        latitude,
        longitude
      ],
      16
    );

  }


  if (marker) {

    marker.setLatLng(
      [
        latitude,
        longitude
      ]
    );

  } else {

    marker =
      L.marker(
        [
          latitude,
          longitude
        ]
      ).addTo(
        map
      );

  }


  marker.bindPopup(

    "<b>Ubicación recibida</b><br>" +

    latitude +
    "<br>" +

    longitude

  ).openPopup();


  /* =========================
     GOOGLE MAPS
  ========================= */

  mapsUrl =
    "https://www.google.com/maps?q=" +
    latitude +
    "," +
    longitude;


  mapsButton.style.display =
    "block";

}


/* =========================
   CREAR OTRO
========================= */

newButton.addEventListener(
  "click",
  () => {

    if (timer) {

      clearInterval(
        timer
      );

    }


    requestId =
      null;


    mapsUrl =
      null;


    if (map) {

      map.remove();

      map =
        null;

      marker =
        null;

    }


    result.style.display =
      "none";


    mapContainer.style.display =
      "none";


    mapsButton.style.display =
      "none";


    dataElement.style.display =
      "none";


    createButton.disabled =
      false;


    statusElement.textContent =
      "Esperando...";

  }
);


</script>

</body>

</html>
